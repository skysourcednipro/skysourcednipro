function setBadge(p, n, color) {
    $$(`[data-badge="${p}"]`).forEach(b => {
        if (!b.dataset.base) b.dataset.base = b.className.replace(/\bhidden\b/, '').trim();
        b.textContent = n;
        b.className = b.dataset.base + (n > 0 ? ` ${color}` : ' hidden');

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0f172a">
    <meta name="robots" content="noindex, nofollow">
    <title>SkySource CRM</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232563eb'><path d='M12 2.69L5.64 9.76a8 8 0 1 0 12.72 0L12 2.69z'/></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif; -webkit-tap-highlight-color: transparent; }
        .hidden-view { display: none !important; }
        .fade-in { animation: fadeIn .25s ease-out both; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .no-scrollbar::-webkit-scrollbar { display: none; } .no-scrollbar { scrollbar-width: none; }
        #toast { transition: all .25s; }
        #toast.show { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
        .sheet-bg { opacity: 0; pointer-events: none; transition: opacity .2s; }
        .sheet-bg.open { opacity: 1; pointer-events: auto; }
        .sheet { transform: translateY(100%); transition: transform .3s cubic-bezier(.2,.9,.3,1), opacity .2s, visibility 0s linear .3s; pointer-events: none; visibility: hidden; }
        .sheet.open { transform: none; pointer-events: auto; visibility: visible; transition-delay: 0s; }
        @media (min-width: 768px) {
            .sheet { transform: translate(-50%, -46%) scale(.97); opacity: 0; }
            .sheet.open { transform: translate(-50%, -50%) scale(1); opacity: 1; }
            .drawer { transform: translateX(100%); }
            .drawer.open { transform: none; }
        }
        .pb-safe { padding-bottom: max(env(safe-area-inset-bottom), 0px); }
        .seg button.on { background: #fff; color: #1d4ed8; box-shadow: 0 1px 2px rgba(15,23,42,.08); }
        .nav-btn.on { background: rgba(37,99,235,.14); color: #93c5fd; }
        .mnav-btn.on { color: #2563eb; }
        .mnav-btn.on .mnav-ico { background: #eff6ff; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen">

    <!-- Сповіщення -->
    <div id="toast" class="fixed top-4 left-1/2 z-[200] px-5 py-3 rounded-2xl shadow-2xl opacity-0 pointer-events-none font-bold text-sm max-w-[90vw] text-center" style="transform: translate(-50%, -20px)"></div>

    <!-- ЕКРАН ВХОДУ -->
    <div id="auth-screen" class="fixed inset-0 bg-slate-900 z-[150] flex items-center justify-center p-4">
        <div class="bg-white p-8 rounded-3xl shadow-2xl max-w-sm w-full text-center">
            <div class="w-14 h-14 bg-blue-600 rounded-2xl mx-auto flex items-center justify-center mb-4 shadow-lg shadow-blue-600/30">
                <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69L5.64 9.76a8 8 0 1 0 12.72 0L12 2.69z"/></svg>
            </div>
            <h1 class="text-2xl font-black text-slate-900">SkySource CRM</h1>
            <p class="text-slate-500 text-sm mt-1 mb-7">Вхід лише для співробітників</p>
            <button id="btn-login" class="w-full py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-bold active:scale-[.98] transition flex items-center justify-center gap-3">
                <svg class="w-5 h-5" viewBox="0 0 48 48"><path fill="#fff" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#fff" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#fff" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#fff" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                Увійти через Google
            </button>
            <p id="auth-error" class="text-red-500 mt-4 text-sm font-bold hidden">Цей акаунт не має доступу. Зверніться до власника.</p>
        </div>
    </div>

    <!-- ОСНОВНИЙ ІНТЕРФЕЙС -->
    <div id="app" class="hidden-view md:flex min-h-screen">

        <!-- Сайдбар (ПК) -->
        <aside class="hidden md:flex w-64 shrink-0 bg-slate-900 text-slate-400 flex-col h-screen sticky top-0">
            <div class="px-6 py-6 flex items-center gap-3 text-white">
                <div class="w-9 h-9 bg-blue-600 rounded-xl flex items-center justify-center"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69L5.64 9.76a8 8 0 1 0 12.72 0L12 2.69z"/></svg></div>
                <span class="text-xl font-black tracking-tight">SkySource</span>
            </div>
            <nav id="side-nav" class="flex-1 px-3 space-y-1"></nav>
            <div class="p-4 border-t border-slate-800">
                <p class="text-white text-sm font-bold truncate" data-me-email></p>
                <p class="text-blue-400 text-[11px] font-black uppercase tracking-wider mb-3" data-me-role></p>
                <button data-logout class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-bold">Вийти</button>
            </div>
        </aside>

        <!-- Робоча зона -->
        <main class="flex-1 min-w-0 pb-24 md:pb-0">

            <!-- Мобільна шапка -->
            <header class="md:hidden sticky top-0 z-40 bg-slate-900 text-white px-4 py-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69L5.64 9.76a8 8 0 1 0 12.72 0L12 2.69z"/></svg></div>
                    <span class="font-black">SkySource</span>
                </div>
                <button id="btn-me" class="text-right leading-tight">
                    <span class="block text-[11px] text-slate-400 truncate max-w-[180px]" data-me-email></span>
                    <span class="block text-[10px] text-blue-400 font-black uppercase" data-me-role></span>
                </button>
            </header>

            <!-- ============ ЗАМОВЛЕННЯ ============ -->
            <section id="panel-orders" class="panel hidden-view p-4 md:p-8 max-w-5xl">
                <div class="flex items-start justify-between gap-3 mb-4">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900">Замовлення</h1>
                        <p id="orders-summary" class="text-slate-500 text-sm mt-0.5">Завантаження…</p>
                    </div>
                    <button data-new-order class="shrink-0 px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl shadow-lg shadow-blue-600/25 active:scale-95 transition flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
                        <span class="hidden sm:inline">Нове замовлення</span><span class="sm:hidden">Нове</span>
                    </button>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 mb-4">
                    <div class="seg flex bg-slate-200/80 p-1 rounded-xl text-sm font-bold text-slate-500 whitespace-nowrap" id="orders-seg">
                        <button data-f="active" class="on flex-1 sm:flex-none px-4 py-2 rounded-lg">Активні <span id="cnt-active" class="ml-1 bg-blue-600 text-white rounded-full px-2 text-[11px]">0</span></button>
                        <button data-f="done" class="flex-1 sm:flex-none px-4 py-2 rounded-lg">Виконані</button>
                        <button data-f="all" class="flex-1 sm:flex-none px-4 py-2 rounded-lg">Всі</button>
                    </div>
                    <div class="relative flex-1">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M20 20l-3.5-3.5"/></svg>
                        <input id="orders-search" type="search" placeholder="Пошук: ім'я, телефон, адреса" class="w-full pl-10 pr-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-blue-500">
                    </div>
                    <button id="btn-copy-route" class="px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-50 whitespace-nowrap" title="Скопіювати всі активні замовлення одним списком">📋 Список для кур'єра</button>
                </div>

                <div id="orders-list" class="space-y-6"></div>
            </section>

            <!-- ============ КЛІЄНТИ ============ -->
            <section id="panel-clients" class="panel hidden-view p-4 md:p-8 max-w-5xl">
                <div class="flex items-start justify-between gap-3 mb-4">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900">Клієнти</h1>
                        <p id="clients-summary" class="text-slate-500 text-sm mt-0.5"></p>
                    </div>
                    <div class="flex gap-2 shrink-0">
                        <button id="btn-export-csv" class="px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-50" title="Відкривається в Excel / Google Таблицях">⬇ Excel</button>
                        <button id="btn-export-txt" class="px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-50">⬇ TXT</button>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-2 mb-4">
                    <div class="seg flex bg-slate-200/80 p-1 rounded-xl text-sm font-bold text-slate-500 overflow-x-auto no-scrollbar" id="clients-seg">
                        <button data-f="all" class="on px-3 py-2 rounded-lg whitespace-nowrap">Всі</button>
                        <button data-f="regular" class="px-3 py-2 rounded-lg whitespace-nowrap">Постійні</button>
                        <button data-f="sleeping" class="px-3 py-2 rounded-lg whitespace-nowrap" title="Не замовляли понад 30 днів">Давно не замовляли</button>
                        <button data-f="none" class="px-3 py-2 rounded-lg whitespace-nowrap">Без замовлень</button>
                    </div>
                    <div class="relative flex-1">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M20 20l-3.5-3.5"/></svg>
                        <input id="clients-search" type="search" placeholder="Пошук клієнта" class="w-full pl-10 pr-3 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-blue-500">
                    </div>
                </div>
                <div id="clients-list" class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100 overflow-hidden"></div>
            </section>

            <!-- ============ АНАЛІТИКА ============ -->
            <section id="panel-analytics" class="panel hidden-view p-4 md:p-8 max-w-5xl">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
                    <h1 class="text-2xl md:text-3xl font-black text-slate-900">Аналітика</h1>
                    <div class="seg flex bg-slate-200/80 p-1 rounded-xl text-sm font-bold text-slate-500 whitespace-nowrap" id="period-seg">
                        <button data-p="day" class="flex-1 px-4 py-2 rounded-lg">Сьогодні</button>
                        <button data-p="week" class="flex-1 px-4 py-2 rounded-lg">7 днів</button>
                        <button data-p="month" class="on flex-1 px-4 py-2 rounded-lg">30 днів</button>
                        <button data-p="year" class="flex-1 px-4 py-2 rounded-lg">Рік</button>
                    </div>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4" id="kpis"></div>
                <div class="bg-white p-4 md:p-6 rounded-2xl border border-slate-200 mb-4">
                    <h3 id="chart-title" class="font-black text-slate-800 mb-3">Продано бутлів</h3>
                    <div class="relative h-56 md:h-72"><canvas id="salesChart"></canvas></div>
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                    <div class="bg-white p-4 md:p-6 rounded-2xl border border-slate-200">
                        <h3 class="font-black text-slate-800 mb-3">Найактивніші клієнти за період</h3>
                        <div id="top-clients" class="divide-y divide-slate-100"></div>
                    </div>
                    <div class="bg-white p-4 md:p-6 rounded-2xl border border-slate-200">
                        <h3 class="font-black text-slate-800 mb-3">Як рахуються показники</h3>
                        <ul class="text-sm text-slate-500 space-y-2 leading-relaxed">
                            <li><b class="text-slate-700">Нові</b> — перше замовлення клієнта припало на цей період.</li>
                            <li><b class="text-slate-700">Повторні</b> — клієнт уже замовляв раніше.</li>
                            <li><b class="text-slate-700">Середній чек</b> — дохід ÷ кількість замовлень.</li>
                            <li>Клієнт визначається за номером телефону.</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- ============ ВІДГУКИ ============ -->
            <section id="panel-reviews" class="panel hidden-view p-4 md:p-8 max-w-5xl">
                <h1 class="text-2xl md:text-3xl font-black text-slate-900">Відгуки</h1>
                <p class="text-slate-500 text-sm mt-0.5 mb-4">Нові відгуки з'являються на сайті тільки після того, як ви їх опублікуєте.</p>
                <div class="seg inline-flex bg-slate-200/80 p-1 rounded-xl text-sm font-bold text-slate-500 mb-4" id="reviews-seg">
                    <button data-f="pending" class="on px-4 py-2 rounded-lg">На перевірці <span id="cnt-pending" class="ml-1 bg-amber-400 text-slate-900 rounded-full px-2 text-[11px]">0</span></button>
                    <button data-f="published" class="px-4 py-2 rounded-lg">Опубліковані</button>
                </div>
                <div id="reviews-list" class="grid gap-3 md:grid-cols-2"></div>
            </section>

            <!-- ============ КОМАНДА ============ -->
            <section id="panel-admins" class="panel hidden-view p-4 md:p-8 max-w-3xl">
                <h1 class="text-2xl md:text-3xl font-black text-slate-900">Команда</h1>
                <p class="text-slate-500 text-sm mt-0.5 mb-5">Хто має доступ до CRM і що може робити.</p>
                <div class="bg-white p-4 md:p-6 rounded-2xl border border-slate-200 mb-5">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Додати співробітника</label>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input type="email" id="input-new-admin" placeholder="name@gmail.com" class="flex-1 px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 text-sm font-medium">
                        <select id="input-new-role" class="px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 text-sm font-bold text-slate-700"></select>
                        <button id="btn-add-admin" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl">Додати</button>
                    </div>
                    <div class="grid sm:grid-cols-3 gap-2 mt-4 text-xs text-slate-500" id="roles-help"></div>
                </div>
                <div id="admins-list" class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100 overflow-hidden"></div>
            </section>
        </main>

        <!-- Нижня навігація (мобільна) -->
        <nav id="mobile-nav" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-slate-200 flex justify-around pt-1.5 pb-safe"></nav>
    </div>

    <!-- ===== ВІКНО: НОВЕ ЗАМОВЛЕННЯ ===== -->
    <div id="sheet-order-bg" class="sheet-bg fixed inset-0 bg-slate-900/50 backdrop-blur-[2px] z-[90]" data-close-sheet></div>
    <div id="sheet-order" class="sheet fixed z-[95] bottom-0 inset-x-0 md:inset-x-auto md:left-1/2 md:top-1/2 md:bottom-auto md:w-[520px] bg-white rounded-t-3xl md:rounded-3xl shadow-2xl max-h-[92vh] overflow-y-auto">
        <div class="p-5 md:p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-black text-slate-900">Нове замовлення</h2>
                <button data-close-sheet class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center">✕</button>
            </div>
            <p class="text-xs text-slate-500 -mt-2 mb-4">Для замовлень з телефону, Viber чи Telegram. Почніть вводити телефон або ім'я — знайдемо клієнта в базі.</p>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1">Телефон *</label>
                    <input id="mo-phone" type="tel" inputmode="tel" autocomplete="off" placeholder="096 123 45 67" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-blue-500 font-semibold">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1">Ім'я</label>
                    <input id="mo-name" type="text" autocomplete="off" placeholder="Ім'я клієнта" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-blue-500 font-semibold">
                </div>
                <div id="mo-suggest" class="hidden space-y-1.5"></div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1">Адреса доставки *</label>
                    <input id="mo-address" type="text" autocomplete="off" placeholder="Вулиця, будинок, під'їзд, квартира" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-blue-500 font-semibold">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1">Бутлів</label>
                        <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl">
                            <button type="button" id="mo-minus" class="w-12 h-12 text-2xl font-black text-slate-500">−</button>
                            <input id="mo-qty" type="number" min="1" value="1" class="w-full text-center bg-transparent font-black text-lg focus:outline-none">
                            <button type="button" id="mo-plus" class="w-12 h-12 text-2xl font-black text-blue-600">+</button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1">Сума, ₴</label>
                        <input id="mo-price" type="number" min="0" class="w-full px-4 h-12 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-blue-500 font-black text-lg">
                    </div>
                </div>
                <p class="text-[11px] text-slate-400">Ціна як на сайті: 1 бутель — 100 ₴, від 2 — 90 ₴ за бутель. Суму можна змінити вручну.</p>
            </div>
            <button id="mo-submit" class="mt-5 w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-2xl shadow-lg shadow-blue-600/25 active:scale-[.98] transition">Створити замовлення</button>
        </div>
    </div>

    <!-- ===== ПАНЕЛЬ: КАРТКА КЛІЄНТА ===== -->
    <div id="drawer-bg" class="sheet-bg fixed inset-0 bg-slate-900/50 z-[80]" data-close-drawer></div>
    <div id="drawer" class="sheet drawer fixed z-[85] bottom-0 inset-x-0 md:inset-x-auto md:right-0 md:top-0 md:bottom-0 md:w-[440px] bg-slate-50 rounded-t-3xl md:rounded-none shadow-2xl max-h-[92vh] md:max-h-none overflow-y-auto" style="opacity:1"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
import { getAuth, signInWithPopup, GoogleAuthProvider, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-auth.js";
import { getFirestore, collection, getDocs, doc, setDoc, deleteDoc, updateDoc, getDoc, addDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

const firebaseConfig = {
    apiKey: "AIzaSyAutXr0WYq-5CkkJUESpOpIsOrZXKpULjs",
    authDomain: "skysource.firebaseapp.com",
    projectId: "skysource",
    storageBucket: "skysource.firebasestorage.app",
    messagingSenderId: "1033630811129",
    appId: "1:1033630811129:web:0388eb20c87250b28ab328"
};
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const provider = new GoogleAuthProvider();

const OWNER_EMAIL = 'skysourcednipro@gmail.com';

/* ---------- Ролі (як і раніше) ----------
   manager   — тільки замовлення
   admin     — + аналітика і відгуки
   assistant — повний доступ (клієнти, команда)
   owner     — повний доступ                      */

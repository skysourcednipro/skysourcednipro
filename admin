}
function clientStats(u) {
    const k = phoneKey(u.phone);
    const orders = state.orders.filter(o => o.uid === u.id || (k && phoneKey(o.phone) === k));
    const last = orders.reduce((m, o) => Math.max(m, o.timestamp || 0), 0);
    return {
        orders,
        count: orders.length,
        bottles: orders.reduce((s, o) => s + (parseInt(o.quantity) || 0), 0),
        spent: orders.reduce((s, o) => s + (parseFloat(o.totalPrice) || 0), 0),
        last,
    };
}
function clientRows() {
    return state.users.map(u => ({ u, s: clientStats(u) }));
}
function renderClients() {
    if (!state.usersLoaded) { $('#clients-list').innerHTML = skeleton(4, true); return; }
    const rows = clientRows();
    const q = state.clientSearch.trim().toLowerCase();
    const now = Date.now();
    const f = state.clientFilter;
    const filtered = rows.filter(({ u, s }) => {
        if (f === 'regular' && s.count < 2) return false;
        if (f === 'sleeping' && !(s.count > 0 && now - s.last > 30 * DAY)) return false;
        if (f === 'none' && s.count > 0) return false;
        if (!q) return true;
        const qd = digits(q);
        return [u.name, u.address].some(v => String(v || '').toLowerCase().includes(q)) || (qd.length >= 3 && digits(u.phone).includes(qd));
    }).sort((a, b) => (b.s.last || b.u.timestamp || 0) - (a.s.last || a.u.timestamp || 0));

    const regular = rows.filter(r => r.s.count >= 2).length;
    $('#clients-summary').textContent = `${rows.length} ${plural(rows.length, ['клієнт', 'клієнти', 'клієнтів'])} · постійних: ${regular}`;


// Довідник відомих клієнтів: з бази клієнтів (якщо є доступ) + з історії замовлень
function knownClients() {
    const m = new Map();
    for (const o of state.orders) {
        const k = phoneKey(o.phone); if (!k) continue;
        const c = m.get(k) || { phone: o.phone, name: o.name, address: o.address, count: 0, last: 0 };
        c.count++;
        if ((o.timestamp || 0) > c.last) Object.assign(c, { last: o.timestamp || 0, phone: o.phone, name: o.name || c.name, address: o.address || c.address });
        m.set(k, c);
    }
    for (const u of state.users) {
        const k = phoneKey(u.phone); if (!k) continue;
        const c = m.get(k) || { phone: u.phone, count: 0, last: 0 };
        c.name = c.name || u.name; c.address = c.address || u.address;
        m.set(k, c);
    }
    return [...m.values()];
}
function suggest() {
    const pd = digits($('#mo-phone').value);
    const nq = $('#mo-name').value.trim().toLowerCase();
    const box = $('#mo-suggest');
    if (pd.length < 3 && nq.length < 2) { box.classList.add('hidden'); return; }
    const res = knownClients().filter(c => (pd.length >= 3 && digits(c.phone).includes(pd)) || (nq.length >= 2 && String(c.name || '').toLowerCase().includes(nq)))
        .sort((a, b) => b.last - a.last).slice(0, 4);
    if (!res.length) { box.classList.add('hidden'); return; }
    box.innerHTML = `<p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Знайдено в базі — натисніть, щоб підставити</p>` + res.map((c, i) => `
        <button type="button" data-sug="${i}" class="w-full text-left p-3 bg-blue-50 hover:bg-blue-100 border border-blue-100 rounded-xl">
            <span class="block text-sm font-black text-slate-800">${esc(c.name || 'Без імені')} <span class="font-mono font-bold text-blue-600">${esc(c.phone)}</span></span>
            <span class="block text-xs text-slate-500 truncate">📍 ${esc(c.address || '—')}${c.count ? ` · ${c.count} зам.` : ''}</span>
        </button>`).join('');
    box.classList.remove('hidden');
    $$('[data-sug]', box).forEach(b => b.onclick = () => {
        const c = res[+b.dataset.sug];
        $('#mo-phone').value = c.phone || ''; $('#mo-name').value = c.name || ''; $('#mo-address').value = c.address || '';
        box.classList.add('hidden'); $('#mo-qty').focus();
    });
}
$('#mo-phone').addEventListener('input', suggest);

        return `<div class="bg-white p-4 rounded-2xl border ${pend ? 'border-amber-300' : 'border-slate-200'} flex flex-col">
            <div class="flex justify-between items-start gap-2 mb-2">
                <div><p class="font-black text-slate-900">${esc(r.name || 'Користувач')}</p><p class="text-[11px] text-slate-400 font-bold">${r.timestamp ? new Date(r.timestamp).toLocaleDateString('uk-UA') : ''}</p></div>
                <span class="text-amber-400 tracking-wider">${'★'.repeat(rating)}<span class="text-slate-200">${'★'.repeat(5 - rating)}</span></span>
            </div>
            <p class="text-sm text-slate-600 flex-1 whitespace-pre-line">${esc(r.text)}</p>
            <div class="flex gap-2 mt-3 pt-3 border-t border-slate-100">
                ${pend ? `<button data-r="publish" data-id="${esc(r.id)}" class="flex-1 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm rounded-xl">Опублікувати</button>`
                       : `<button data-r="hide" data-id="${esc(r.id)}" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-sm rounded-xl">Сховати з сайту</button>`}
                <button data-r="delete" data-id="${esc(r.id)}" class="px-4 py-2.5 text-red-500 hover:bg-red-50 font-bold text-sm rounded-xl">Видалити</button>
            </div>
        </div>`;
    }).join('');
}
$('#reviews-list').addEventListener('click', async e => {
    const b = e.target.closest('[data-r]'); if (!b) return;
    const id = b.dataset.id;
    try {
        if (b.dataset.r === 'publish') { await updateDoc(doc(db, 'reviews', id), { approved: true }); toast('Відгук опубліковано'); }
        if (b.dataset.r === 'hide') { await updateDoc(doc(db, 'reviews', id), { approved: false }); toast('Відгук приховано з сайту'); }
        if (b.dataset.r === 'delete') { if (!confirm('Видалити відгук назавжди?')) return; await deleteDoc(doc(db, 'reviews', id)); toast('Відгук видалено'); }
        loadReviews(false);
    } catch { toast('Помилка збереження', true); }
});
bindSeg('reviews-seg', d => { state.reviewFilter = d.f; renderReviews(); });

/* =========================================================
   КОМАНДА
========================================================= */
const ROLE_OPTS = [
    { v: 'manager', name: 'Менеджер', desc: 'Тільки замовлення' },
    { v: 'admin', name: 'Адміністратор', desc: 'Замовлення, аналітика, відгуки' },
    { v: 'assistant', name: 'Помічник власника', desc: 'Повний доступ, включно з клієнтами і командою' },
];
$('#input-new-role').innerHTML = ROLE_OPTS.map(r => `<option value="${r.v}">${r.name}</option>`).join('');
$('#roles-help').innerHTML = ROLE_OPTS.map(r => `<div class="bg-slate-50 rounded-xl p-3"><b class="text-slate-700 block">${r.name}</b>${r.desc}</div>`).join('');

async function loadAdmins() {
    if (!can('admins')) return;
    $('#admins-list').innerHTML = skeleton(2, true);
    try {
        const snap = await getDocs(collection(db, 'admins'));
        state.admins = []; snap.forEach(d => { const x = d.data(); if (x.email !== OWNER_EMAIL) state.admins.push({ id: d.id, ...x }); });
        state.admins.sort((a, b) => (a.addedAt || 0) - (b.addedAt || 0));
        $('#admins-list').innerHTML = `
            <div class="p-4 flex items-center gap-3 bg-blue-50/60">
                <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-black text-xs shrink-0">Вл</div>
                <div class="flex-1 min-w-0"><p class="font-bold text-slate-900 truncate">${esc(OWNER_EMAIL)}</p><p class="text-[11px] font-black text-blue-600 uppercase">Власник</p></div>
            </div>` + (state.admins.length ? state.admins.map(a => `
            <div class="p-4 flex flex-col sm:flex-row sm:items-center gap-3">
                <div class="flex-1 min-w-0"><p class="font-bold text-slate-800 truncate">${esc(a.email || a.id)}</p>${a.addedAt ? `<p class="text-[11px] text-slate-400">додано ${new Date(a.addedAt).toLocaleDateString('uk-UA')}</p>` : ''}</div>
                <div class="flex gap-2">
                    <select data-role="${esc(a.id)}" class="flex-1 sm:flex-none px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-700">
                        ${ROLE_OPTS.map(r => `<option value="${r.v}" ${(a.role || 'manager') === r.v ? 'selected' : ''}>${r.name}</option>`).join('')}
                    </select>
                    <button data-remove="${esc(a.id)}" class="px-4 py-2 border border-red-200 text-red-500 hover:bg-red-50 font-bold text-sm rounded-xl">Забрати доступ</button>
                </div>
            </div>`).join('') : '<p class="p-5 text-sm text-slate-400 text-center">Співробітників ще не додано</p>');
    } catch (e) { console.error(e); $('#admins-list').innerHTML = '<div class="p-6 text-red-500 text-center font-bold">Помилка завантаження</div>'; }
}
$('#admins-list').addEventListener('change', async e => {
    const s = e.target.closest('[data-role]'); if (!s) return;
    try { await updateDoc(doc(db, 'admins', s.dataset.role), { role: s.value }); toast('Роль змінено'); }
    catch { toast('Помилка збереження', true); loadAdmins(); }
});
$('#admins-list').addEventListener('click', async e => {
    const b = e.target.closest('[data-remove]'); if (!b) return;
    const email = b.dataset.remove;
    if (email === OWNER_EMAIL) return toast('Власника не можна видалити', true);
    if (!confirm(`Забрати доступ у ${email}?`)) return;
    try { await deleteDoc(doc(db, 'admins', email)); toast('Доступ забрано'); loadAdmins(); } catch { toast('Помилка', true); }
});
$('#btn-add-admin').onclick = async () => {
    if (busy) return;
    const email = $('#input-new-admin').value.trim().toLowerCase();
    const r = $('#input-new-role').value;
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return toast('Введіть коректну пошту', true);
    if (email === OWNER_EMAIL) return toast('Це пошта власника', true);
    busy = true; $('#btn-add-admin').textContent = '…';
    try { await setDoc(doc(db, 'admins', email), { email, role: r, addedAt: Date.now() }); $('#input-new-admin').value = ''; toast('Доступ надано'); loadAdmins(); }
    catch { toast('Помилка БД. Перевірте права', true); }
    finally { busy = false; $('#btn-add-admin').textContent = 'Додати'; }
};

/* ---------- Заглушка завантаження ---------- */
function skeleton(n, rows = false) {
    return Array.from({ length: n }, () => rows
        ? '<div class="p-4 flex gap-3 animate-pulse"><div class="w-11 h-11 rounded-full bg-slate-200"></div><div class="flex-1 space-y-2 py-1"><div class="h-3 bg-slate-200 rounded w-1/2"></div><div class="h-3 bg-slate-100 rounded w-3/4"></div></div></div>'
        : '<div class="bg-white rounded-2xl border border-slate-200 p-4 animate-pulse space-y-2"><div class="h-3 bg-slate-200 rounded w-1/3"></div><div class="h-5 bg-slate-200 rounded w-1/2"></div><div class="h-3 bg-slate-100 rounded w-3/4"></div></div>').join('');
}

// Оновлювати «хв тому» щохвилини
setInterval(() => { if (currentPanel === 'orders' && state.ordersLoaded) renderOrders(); }, 60000);
</script>

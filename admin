/* =========================================================
   ЗАМОВЛЕННЯ (оновлюються наживо)
========================================================= */
let knownOrderIds = null;
function subscribeOrders() {
    onSnapshot(collection(db, 'orders'), snap => {
        const list = [];
        snap.forEach(d => list.push({ id: d.id, ...d.data() }));
        list.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

        // Сигнал про нове замовлення з сайту
        if (knownOrderIds) {
            const fresh = list.filter(o => !knownOrderIds.has(o.id) && o.source !== 'manual' && !isDone(o));
            if (fresh.length) { toast(`🔔 Нове замовлення: ${fresh[0].name || 'клієнт'} — ${bottles(parseInt(fresh[0].quantity) || 0)}`); beep(); }
        }
        knownOrderIds = new Set(list.map(o => o.id));

        state.orders = list; state.ordersLoaded = true;
        const active = list.filter(o => !isDone(o)).length;
        $('#cnt-active').textContent = active;
        setBadge('orders', active, 'bg-blue-600 text-white');
        document.title = (active ? `(${active}) ` : '') + 'SkySource CRM';
        if (currentPanel === 'orders') renderOrders();
        if (currentPanel === 'clients') renderClients();
        if (currentPanel === 'analytics') renderAnalytics();
    }, err => {
        console.error(err);
        $('#orders-list').innerHTML = `<div class="bg-red-50 text-red-600 p-6 rounded-2xl text-center font-bold">Не вдалося завантажити замовлення. Перевірте інтернет або права доступу.</div>`;
    });
}
function beep() {
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        [0, .18].forEach(d => {
            const o = ctx.createOscillator(), g = ctx.createGain();
            o.frequency.value = 880; o.connect(g); g.connect(ctx.destination);
            g.gain.setValueAtTime(.12, ctx.currentTime + d); g.gain.exponentialRampToValueAtTime(.001, ctx.currentTime + d + .15);
            o.start(ctx.currentTime + d); o.stop(ctx.currentTime + d + .16);
        });
    } catch { /* без звуку */ }
}

// Скільки разів клієнт замовляв (за телефоном)
function orderCountsByClient() {
    const m = new Map();
    for (const o of state.orders) { const k = phoneKey(o.phone) || o.uid; m.set(k, (m.get(k) || 0) + 1); }
    return m;
}
function matchesSearch(o, q) {
    if (!q) return true;
    const qd = digits(q);
    return [o.name, o.address].some(v => String(v || '').toLowerCase().includes(q)) || (qd.length >= 3 && digits(o.phone).includes(qd));
}

function renderOrders() {
    if (!state.ordersLoaded) { $('#orders-list').innerHTML = skeleton(3); return; }
    const q = state.orderSearch.trim().toLowerCase();
    const f = state.orderFilter;
    const list = state.orders.filter(o => (f === 'all' || (f === 'active' ? !isDone(o) : isDone(o))) && matchesSearch(o, q));
    const counts = orderCountsByClient();

    const today = startOfDay(Date.now());
    const tOrders = state.orders.filter(o => (o.timestamp || 0) >= today);
    const tBottles = tOrders.reduce((s, o) => s + (parseInt(o.quantity) || 0), 0);
    $('#orders-summary').textContent = `Сьогодні: ${tOrders.length} ${plural(tOrders.length, ['замовлення', 'замовлення', 'замовлень'])} · ${bottles(tBottles)}`;

    if (!list.length) {
        const msg = q ? 'Нічого не знайдено' : f === 'active' ? 'Активних замовлень немає 🎉' : 'Замовлень немає';
        $('#orders-list').innerHTML = `<div class="text-center text-slate-400 font-bold py-16">${msg}</div>`;
        return;
    }
    const limit = f === 'active' ? list.length : Math.min(list.length, state.orderLimit || 60);
    const groups = [];
    for (const o of list.slice(0, limit)) {
        const label = o.timestamp ? dayLabel(o.timestamp) : 'Без дати';
        let g = groups[groups.length - 1];
        if (!g || g.label !== label) { g = { label, items: [] }; groups.push(g); }
        g.items.push(o);
    }
    $('#orders-list').innerHTML = groups.map(g => {
        const b = g.items.reduce((s, o) => s + (parseInt(o.quantity) || 0), 0);
        return `<div>
            <div class="flex items-baseline justify-between px-1 mb-2">
                <h2 class="text-sm font-black text-slate-500 uppercase tracking-wider first-letter:uppercase">${esc(g.label)}</h2>
                <span class="text-xs font-bold text-slate-400">${g.items.length} зам. · ${bottles(b)}</span>
            </div>
            <div class="space-y-2">${g.items.map(o => orderCard(o, counts)).join('')}</div>
        </div>`;
    }).join('') + (limit < list.length ? `<button id="btn-more" class="w-full py-3 bg-white border border-slate-200 rounded-xl font-bold text-slate-600">Показати ще (${list.length - limit})</button>` : '');
    const more = $('#btn-more'); if (more) more.onclick = () => { state.orderLimit = (state.orderLimit || 60) + 60; renderOrders(); };
}

function orderCard(o, counts) {
    const done = isDone(o);
    const qty = parseInt(o.quantity) || 0;
    const n = counts.get(phoneKey(o.phone) || o.uid) || 1;
    const waitingH = !done && o.timestamp ? (Date.now() - o.timestamp) / 3600000 : 0;
    const tel = telHref(o.phone);
    const tags = [];
    if (o.source === 'manual') tags.push('<span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded-md">Вручну</span>');
    else tags.push('<span class="bg-sky-100 text-sky-700 px-2 py-0.5 rounded-md">Сайт</span>');
    tags.push(n > 1 ? `<span class="bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-md">${n}-е замовлення</span>` : '<span class="bg-amber-100 text-amber-700 px-2 py-0.5 rounded-md">Новий клієнт</span>');
    if (waitingH >= 3) tags.push(`<span class="bg-red-100 text-red-700 px-2 py-0.5 rounded-md">Чекає ${Math.floor(waitingH)} год</span>`);

    return `<article class="bg-white rounded-2xl border ${done ? 'border-slate-200 opacity-70' : 'border-slate-200 shadow-sm'} overflow-hidden flex">
        <div class="w-1.5 shrink-0 ${done ? 'bg-slate-300' : 'bg-blue-500'}"></div>
        <div class="flex-1 min-w-0 p-4">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-bold mb-1.5">
                        <span class="text-slate-500">${timeStr(o.timestamp)}</span>
                        ${!done ? `<span class="text-slate-400">· ${ago(o.timestamp)}</span>` : '<span class="bg-slate-100 text-slate-500 px-2 py-0.5 rounded-md">✓ Виконано</span>'}
                        ${tags.join('')}
                    </div>
                    <p class="text-lg font-black text-slate-900 leading-tight">${esc(bottles(qty))} <span class="text-blue-600">· ${money(o.totalPrice)}</span></p>
                </div>
                ${!done
                    ? `<button data-act="done" data-id="${esc(o.id)}" class="shrink-0 px-4 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-black text-sm rounded-xl active:scale-95 transition">✓ Виконано</button>`
                    : `<button data-act="reopen" data-id="${esc(o.id)}" class="shrink-0 px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-xs rounded-xl">↺ Повернути</button>`}
            </div>
            <div class="mt-2 space-y-1 text-sm">
                <p class="font-bold text-slate-800">${esc(o.name || 'Без імені')} ${o.phone ? `· <a href="${tel}" class="font-mono text-blue-600 hover:underline">${esc(o.phone)}</a>` : ''}</p>
                <p class="text-slate-600">📍 ${esc(o.address || '—')}</p>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-3">
                ${tel ? `<a href="${tel}" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-bold text-slate-700">📞 Дзвінок</a>` : ''}
                <button data-act="copy" data-id="${esc(o.id)}" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-bold text-slate-700">📋 Копіювати</button>
                ${o.address ? `<a href="${mapsLink(o.address)}" target="_blank" rel="noopener" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-bold text-slate-700">🗺 Карта</a>` : ''}
                <button data-act="repeat" data-id="${esc(o.id)}" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-bold text-slate-700">➕ Повторити</button>
                <button data-act="delete" data-id="${esc(o.id)}" class="ml-auto px-3 py-2 text-red-500 hover:bg-red-50 rounded-lg text-xs font-bold" title="Видалити назавжди">Видалити</button>
            </div>
        </div>
    </article>`;
}
const orderText = o => `Ім'я: ${o.name || '-'}\nТелефон: ${o.phone || '-'}\nАдреса: ${o.address || '-'}\nБутлів: ${o.quantity} (${money(o.totalPrice)})`;

$('#orders-list').addEventListener('click', async e => {
    const b = e.target.closest('[data-act]'); if (!b) return;
    const o = state.orders.find(x => x.id === b.dataset.id); if (!o) return;
    const act = b.dataset.act;
    if (act === 'copy') return copy(orderText(o), 'Дані для кур\'єра скопійовано');
    if (act === 'repeat') return openOrderSheet({ name: o.name, phone: o.phone, address: o.address, quantity: parseInt(o.quantity) || 1 });
    if (act === 'done' || act === 'reopen') {
        b.disabled = true;
        try { await updateDoc(doc(db, 'orders', o.id), { status: act === 'done' ? 'archived' : 'processing' }); toast(act === 'done' ? 'Замовлення виконано ✓' : 'Повернуто в роботу'); }
        catch { b.disabled = false; toast('Помилка збереження', true); }
        return;
    }
    if (act === 'delete') {
        if (!confirm(`Видалити замовлення ${o.name || ''} (${bottles(parseInt(o.quantity) || 0)}) назавжди?`)) return;
        try { await deleteDoc(doc(db, 'orders', o.id)); toast('Замовлення видалено'); } catch { toast('Помилка видалення', true); }
    }
});
bindSeg('orders-seg', d => { state.orderFilter = d.f; state.orderLimit = 60; renderOrders(); });
$('#orders-search').addEventListener('input', e => { state.orderSearch = e.target.value; renderOrders(); });
$('#btn-copy-route').onclick = () => {
    const act = state.orders.filter(o => !isDone(o)).slice().reverse();
    if (!act.length) return toast('Активних замовлень немає');
    const text = act.map((o, i) => `${i + 1}. ${o.address || '-'}\n   ${o.name || '-'}, ${o.phone || '-'}\n   ${bottles(parseInt(o.quantity) || 0)} — ${money(o.totalPrice)}`).join('\n\n');
    const total = act.reduce((s, o) => s + (parseInt(o.quantity) || 0), 0);
    copy(`Доставки (${act.length}), всього ${bottles(total)}:\n\n${text}`, `Скопійовано ${act.length} адрес для кур'єра`);
};

/* ---------- Нове замовлення ---------- */
let priceTouched = false;
function openOrderSheet(pre = {}) {
    $('#mo-phone').value = pre.phone || '';
    $('#mo-name').value = pre.name || '';
    $('#mo-address').value = pre.address || '';
    $('#mo-qty').value = pre.quantity || 1;
    priceTouched = false; syncPrice();
    $('#mo-suggest').classList.add('hidden');
    $('#sheet-order-bg').classList.add('open'); $('#sheet-order').classList.add('open');
    setTimeout(() => (pre.phone ? $('#mo-qty') : $('#mo-phone')).focus(), 250);
}
function closeOrderSheet() { $('#sheet-order-bg').classList.remove('open'); $('#sheet-order').classList.remove('open'); }
$$('[data-new-order]').forEach(b => b.onclick = () => openOrderSheet());
$$('[data-close-sheet]').forEach(b => b.onclick = closeOrderSheet);
function syncPrice() { const q = Math.max(1, parseInt($('#mo-qty').value) || 1); if (!priceTouched) $('#mo-price').value = priceFor(q); }
$('#mo-qty').addEventListener('input', syncPrice);
$('#mo-price').addEventListener('input', () => { priceTouched = true; });

bindSeg('period-seg', d => { state.period = d.p; renderAnalytics(); });

function buckets(period) {
    const now = new Date();
    const out = [];
    if (period === 'day') {
        const s = startOfDay(now);
        for (let h = 0; h <= now.getHours(); h++) out.push({ from: s + h * 3600000, to: s + (h + 1) * 3600000, label: `${h}:00` });
    } else if (period === 'week' || period === 'month') {
        const n = period === 'week' ? 7 : 30;
        const s = startOfDay(now);
        for (let i = n - 1; i >= 0; i--) { const f = s - i * DAY; const d = new Date(f); out.push({ from: f, to: f + DAY, label: `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}` }); }
    } else {
        const M = ['Січ', 'Лют', 'Бер', 'Кві', 'Тра', 'Чер', 'Лип', 'Сер', 'Вер', 'Жов', 'Лис', 'Гру'];
        for (let i = 11; i >= 0; i--) {
            const f = new Date(now.getFullYear(), now.getMonth() - i, 1), t = new Date(now.getFullYear(), now.getMonth() - i + 1, 1);
            out.push({ from: f.getTime(), to: t.getTime(), label: `${M[f.getMonth()]} ${String(f.getFullYear()).slice(2)}` });
        }
    }
    return out;
}
function renderAnalytics() {
    if (!can('analytics')) return;
    const b = buckets(state.period);
    const from = b[0].from, prevFrom = from - (Date.now() - from);
    const inP = state.orders.filter(o => (o.timestamp || 0) >= from);
    const prevP = state.orders.filter(o => (o.timestamp || 0) >= prevFrom && (o.timestamp || 0) < from);
    const sum = (arr, f) => arr.reduce((s, o) => s + f(o), 0);
    const rev = sum(inP, o => parseFloat(o.totalPrice) || 0), revPrev = sum(prevP, o => parseFloat(o.totalPrice) || 0);
    const bot = sum(inP, o => parseInt(o.quantity) || 0), botPrev = sum(prevP, o => parseInt(o.quantity) || 0);

    // Перше замовлення кожного клієнта за всю історію
    const first = new Map();
    for (const o of state.orders) { const k = phoneKey(o.phone) || o.uid; const t = o.timestamp || 0; if (!first.has(k) || t < first.get(k)) first.set(k, t); }
    const inClients = new Set(inP.map(o => phoneKey(o.phone) || o.uid));
    let fresh = 0, back = 0;
    inClients.forEach(k => (first.get(k) >= from ? fresh++ : back++));
    const avg = inP.length ? rev / inP.length : 0;

    const delta = (a, p) => { if (!p) return ''; const d = Math.round((a - p) / p * 100); return `<span class="text-[11px] font-black ${d >= 0 ? 'text-emerald-600' : 'text-red-500'}">${d >= 0 ? '▲' : '▼'} ${Math.abs(d)}%</span>`; };
    const kpi = (label, val, extra = '', cls = 'text-slate-900') => `<div class="bg-white p-4 rounded-2xl border border-slate-200"><p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">${label}</p><p class="text-2xl font-black ${cls} mt-1">${val}</p><div class="h-4">${extra}</div></div>`;
    $('#kpis').innerHTML =
        kpi('Дохід', money(rev), delta(rev, revPrev) + '<span class="text-[11px] text-slate-400 ml-1">до попер. періоду</span>') +
        kpi('Продано бутлів', bot, delta(bot, botPrev), 'text-blue-600') +
        kpi('Замовлень', inP.length, `<span class="text-[11px] text-slate-400">середній чек ${money(avg)}</span>`) +
        kpi('Клієнтів', inClients.size, `<span class="text-[11px] text-slate-400">нових ${fresh} · повторних ${back}</span>`);

    $('#chart-title').textContent = { day: 'Бутлі сьогодні по годинах', week: 'Бутлі за 7 днів', month: 'Бутлі за 30 днів', year: 'Бутлі по місяцях' }[state.period];
    const data = b.map(x => sum(inP.filter(o => o.timestamp >= x.from && o.timestamp < x.to), o => parseInt(o.quantity) || 0));
    const ctx = $('#salesChart').getContext('2d');
    if (chart) chart.destroy();
    if (window.Chart) {
        chart = new Chart(ctx, {
            type: 'bar',
            data: { labels: b.map(x => x.label), datasets: [{ label: 'Бутлів', data, backgroundColor: '#3b82f6', hoverBackgroundColor: '#1d4ed8', borderRadius: 6, maxBarThickness: 36 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }, x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkip: true } } } }
        });
    }

    // Топ клієнтів
    const top = new Map();
    for (const o of inP) {
        const k = phoneKey(o.phone) || o.uid;
        const c = top.get(k) || { name: o.name, phone: o.phone, b: 0, n: 0 };
        c.b += parseInt(o.quantity) || 0; c.n++; top.set(k, c);
    }
    const arr = [...top.values()].sort((a, b) => b.b - a.b).slice(0, 5);
    $('#top-clients').innerHTML = arr.length ? arr.map((c, i) => `<div class="py-2.5 flex items-center gap-3 text-sm">
        <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-500 text-xs font-black flex items-center justify-center">${i + 1}</span>
        <span class="flex-1 min-w-0 truncate font-bold">${esc(c.name || 'Без імені')} <span class="font-mono text-xs text-slate-400">${esc(c.phone || '')}</span></span>
        <span class="font-black">${esc(bottles(c.b))}</span></div>`).join('') : '<p class="text-sm text-slate-400 py-4 text-center">За цей період замовлень немає</p>';
}


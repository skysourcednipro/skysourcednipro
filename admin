let chart = null;
let busy = false;

/* ---------- Утиліти ---------- */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const digits = p => String(p || '').replace(/\D/g, '');
const phoneKey = p => digits(p).slice(-10);
const telHref = p => { const d = digits(p); if (!d) return ''; if (d.length === 10 && d[0] === '0') return 'tel:+38' + d; if (d.startsWith('380')) return 'tel:+' + d; return 'tel:' + d; };
const plural = (n, f) => { const a = Math.abs(n) % 100, b = a % 10; if (a > 10 && a < 20) return f[2]; if (b > 1 && b < 5) return f[1]; if (b === 1) return f[0]; return f[2]; };
const bottles = n => `${n} ${plural(n, ['бутель', 'бутлі', 'бутлів'])}`;
const money = n => `${Math.round(Number(n) || 0).toLocaleString('uk-UA')} ₴`;
const isDone = o => o.status === 'archived' || o.status === 'completed';
const priceFor = q => (q === 1 ? 100 : q * 90);   // те саме правило, що на сайті
const DAY = 86400000;

function startOfDay(t) { const d = new Date(t); d.setHours(0, 0, 0, 0); return d.getTime(); }
function dayLabel(t) {
    const today = startOfDay(Date.now());
    const d = startOfDay(t);
    if (d === today) return 'Сьогодні';
    if (d === today - DAY) return 'Вчора';
    return new Date(t).toLocaleDateString('uk-UA', { weekday: 'long', day: 'numeric', month: 'long' });
}
function timeStr(t) { return t ? new Date(t).toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' }) : '--:--'; }
function ago(t) {
    if (!t) return '';
    const m = Math.floor((Date.now() - t) / 60000);
    if (m < 1) return 'щойно';
    if (m < 60) return `${m} хв тому`;
    if (m < 1440) return `${Math.floor(m / 60)} год тому`;
    const d = Math.floor(m / 1440);
    return `${d} ${plural(d, ['день', 'дні', 'днів'])} тому`;
}
function mapsLink(addr) {
    const a = String(addr || '');
    const q = /дніпр|днепр|dnipro/i.test(a) ? a : `Дніпро, ${a}`;
    return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
}

let toastT;
function toast(msg, err = false) {
    const t = $('#toast');
    clearTimeout(toastT);
    t.textContent = msg;
    t.className = `fixed top-4 left-1/2 z-[200] px-5 py-3 rounded-2xl shadow-2xl font-bold text-sm max-w-[90vw] text-center show ${err ? 'bg-red-600 text-white' : 'bg-slate-900 text-white'}`;
    toastT = setTimeout(() => t.classList.remove('show'), 2800);
}
async function copy(text, msg = 'Скопійовано') {
    try { await navigator.clipboard.writeText(text); toast(msg); }
    catch { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); toast(msg); }
}
const can = p => (ROLE_PANELS[role] || []).includes(p);

/* ---------- Авторизація ---------- */
onAuthStateChanged(auth, async (user) => {
    if (!user) { $('#auth-screen').classList.remove('hidden-view'); $('#app').classList.add('hidden-view'); return; }
    try {
        if (user.email === OWNER_EMAIL) role = 'owner';
        else {
            const snap = await getDoc(doc(db, 'admins', user.email));
            if (!snap.exists()) throw new Error('no access');
            role = snap.data().role || 'manager';
            if (!ROLE_PANELS[role]) role = 'manager';
        }
        me = user.email;
        start();
    } catch (e) {
        $('#auth-error').classList.remove('hidden');
        signOut(auth);
    }
});
$('#btn-login').onclick = () => signInWithPopup(auth, provider).catch(() => toast('Не вдалося відкрити вікно входу. Дозвольте спливаючі вікна.', true));
$$('[data-logout]').forEach(b => b.onclick = () => { signOut(auth); location.reload(); });
$('#btn-me').onclick = () => { if (confirm('Вийти з акаунта?')) { signOut(auth); location.reload(); } };

function start() {
    $('#auth-screen').classList.add('hidden-view');
    $('#app').classList.remove('hidden-view');
    $$('[data-me-email]').forEach(e => e.textContent = me);
    $$('[data-me-role]').forEach(e => e.textContent = ROLE_NAMES[role] || '');
    buildNav();
    subscribeOrders();
    if (can('clients')) loadUsers();
    if (can('reviews')) loadReviews(false);
    const hash = location.hash.slice(1);
    go(can(hash) ? hash : 'orders');
}

/* ---------- Навігація ---------- */
function buildNav() {

$('#mo-submit').onclick = async () => {
    if (busy) return;
    const phone = $('#mo-phone').value.trim();
    const name = $('#mo-name').value.trim() || 'Клієнт';
    const address = $('#mo-address').value.trim();
    const quantity = Math.max(1, parseInt($('#mo-qty').value) || 1);
    const totalPrice = Math.max(0, parseInt($('#mo-price').value) || priceFor(quantity));
    if (digits(phone).length < 9) { toast('Вкажіть телефон клієнта', true); $('#mo-phone').focus(); return; }
    if (address.length < 3) { toast('Вкажіть адресу доставки', true); $('#mo-address').focus(); return; }

    busy = true; $('#mo-submit').textContent = 'Збереження…';
    const timestamp = Date.now();
    // Якщо такий «ручний» клієнт уже є — оновлюємо його ж документ, щоб не плодити дублікати
    const existing = state.users.find(u => u.id.startsWith('manual_') && phoneKey(u.phone) === phoneKey(phone));
    const userId = existing ? existing.id : 'manual_' + phone;
    try {
        await addDoc(collection(db, 'orders'), { uid: userId, name, phone, address, quantity, totalPrice, status: 'processing', timestamp, source: 'manual' });
        try { await setDoc(doc(db, 'users', userId), { name, phone, address, addedBy: 'admin', timestamp }, { merge: true }); } catch (e) { console.warn('users write skipped', e); }
        toast('Замовлення створено ✓');
        closeOrderSheet();
        if (can('clients')) loadUsers();
        if (currentPanel !== 'orders') go('orders');
    } catch (e) { console.error(e); toast('Помилка збереження', true); }
    finally { busy = false; $('#mo-submit').textContent = 'Створити замовлення'; }
};

